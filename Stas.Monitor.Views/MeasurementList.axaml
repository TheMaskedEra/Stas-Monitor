<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:presentations="clr-namespace:Stas.Monitor.Presentations;assembly=Stas.Monitor.Presentations"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Stas.Monitor.Views.MeasurementList"
             >
    <StackPanel>
        <TextBlock HorizontalAlignment="Center" FontSize="25"/>
        <ItemsControl x:Name="Measurements">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="presentations:MeasurementViewModel">
                    <StackPanel Margin="2" Spacing="5" Orientation="Horizontal" Background="{Binding Background}">
                        <TextBlock FontSize="35" Text="{Binding Value}"/>
                    
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Moment}"/>
                            <TextBlock Text="{Binding ExpectedValue}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>