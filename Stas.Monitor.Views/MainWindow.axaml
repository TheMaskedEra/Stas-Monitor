<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Stas.Monitor.Views"
        xmlns:presentations="clr-namespace:Stas.Monitor.Presentations;assembly=Stas.Monitor.Presentations"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Stas.Monitor.Views.MainWindow"
        Title="UE36 - Stas Monitor - Alexis Vanden Broeck"
        Width="550" Height="700" CanResize="False"
        >
    <ScrollViewer Margin="10">
        <StackPanel>
            <TextBlock Text="Thermomètres disponibles :" Margin="0 0 5 5"/>
            <ComboBox x:Name="ListName"/>
            
            <ListBox x:Name="Measurements">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type presentations:MeasurementViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="40" Text="{Binding Value}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Moment}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</Window>
