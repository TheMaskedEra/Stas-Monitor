<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="700"
        x:Class="Stas.Monitor.Views.MainWindow"
        Title="UE36 - Stas Monitor - Alexis Vanden Broeck"
        MinWidth="550" MinHeight="700"
        Width="550" Height="700" CanResize="True"
        >
    <ScrollViewer>
        <StackPanel>
            <Expander Width="550" IsExpanded="true">
                <Expander.Header>
                    Display Settings
                </Expander.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    
                    <StackPanel Orientation="Vertical" Margin="0 0 10 0">
                        <TextBlock Margin="3">Available Thermometers:</TextBlock>
                        <ComboBox x:Name="ListName" VerticalAlignment="Center" SelectionChanged="OnSelectedThermometer"></ComboBox>
                    </StackPanel>
                    
                    <StackPanel x:Name="CheckBoxTypes" Orientation="Vertical" Margin="0 0 10 0">
                        <TextBlock Margin="3">Available series:</TextBlock>
                        <!-- Dynamic checkbox -->
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical">
                        <TextBlock Margin="3">Duration:</TextBlock>
                        <ComboBox x:Name="Timers" VerticalAlignment="Center" SelectionChanged="Timers_OnSelectionChanged"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
            <ItemsControl>
                
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="10" x:Name="MeasurementLists">
                <!-- Dynamic measurement list -->
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
